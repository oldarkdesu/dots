# evdev:input:b0003v1532p022B*
# /etc/udev/hwdb.d/99-test.hwdb
# Input device ID: bus 0x3 vendor 0x1532 product 0x22b version 0x111
#
# This file is to remap the keys on the Razor Tartarus v2
# The single space in front of every uncommented line is important, as well as the last line of this file not being a final newline
# Also, don't leave empty lines...
#
# Default profile
#
evdev:input:b0003v1532p022b*
#
# Top row
 KEYBOARD_KEY_7001e=6
 KEYBOARD_KEY_7001f=7
 KEYBOARD_KEY_70020=8
 KEYBOARD_KEY_70021=9
 KEYBOARD_KEY_70022=0
#
# Second row
 KEYBOARD_KEY_7002b=1
 KEYBOARD_KEY_70014=2
 KEYBOARD_KEY_7001a=3
 KEYBOARD_KEY_70008=4
 KEYBOARD_KEY_70015=5
#
# Third row
 KEYBOARD_KEY_70039=grave
 KEYBOARD_KEY_70004=s
 KEYBOARD_KEY_70016=a
 KEYBOARD_KEY_70007=d
 KEYBOARD_KEY_70009=space
#
# Fourth row
 KEYBOARD_KEY_700e1=esc
 KEYBOARD_KEY_7001d=tab
 KEYBOARD_KEY_7001b=leftctrl
 KEYBOARD_KEY_70006=leftshift
#
# Thumb button above thumbstick
 KEYBOARD_KEY_700e2=w
#
# Thumbstick
 KEYBOARD_KEY_70052=w
 KEYBOARD_KEY_70051=w
 KEYBOARD_KEY_70050=w
 KEYBOARD_KEY_7004f=w
#
# Thumb button below thumbstick
 KEYBOARD_KEY_7002c=w
