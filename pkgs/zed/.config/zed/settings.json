{
	/* VISUALS */
	"ui_font_size": 16,
	"ui_font_family": "Fira Sans",

	"buffer_font_size": 18,
	"buffer_font_family": "Iosevka Curly",
	"buffer_line_height": "standard",
	"buffer_font_features": { "calt": false }, // disable ligatures

	"agent_ui_font_size": 18,
	"agent_buffer_font_size": 14,

	"terminal": {
		"line_height": "standard",
		"font_size": 18,
		"font_family": "Iosevka Curly",
	},
	"autoscroll_on_clicks": true,
	"auto_install_extensions": {
		"html": true,
		"toml": true,
		"git-firefly": true,
		"tokyo-night": true,
		"symbols": true,
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Symbols Icon Theme",
		"dark": "Symbols Icon Theme",
	},
	"theme": {
		"mode": "dark",
		"light": "Catppuccin Latte",
		"dark": "Tokyo Night",
	},
	"semantic_tokens": "combined",
	"theme_overrides": {
		"Ayu Dark": {
			"editor.gutter.background": "#0a0a0f",
			"syntax": {
				// "string.doc":{"color": "#5c6773ff"},
				// AyuDark's colors
				// Comments #5c6773ff
				// Editor Background #0d1016ff
				//
				// TODO WIP MAYBE ?
				// HACK WARNING WARN SAFETY IMPORTANT #
				// INFO NOTE XXX DOCS PERF TEST *
				// FIXME ERROR FIXME FIX BUG DELETE !

				"constant.comment.todo": {
					"color": "#55b4D3ff",
					"background_color": "#55b4D33d",
				},
				"constant.comment.todo.prefix": { "color": "#5c6773ff" },
				"constant.comment.todo.bracket": { "color": "#55b4D3ff" },
				"constant.comment.todo.user": { "color": "#55b4D3ff" },
				"constant.comment.todo.text": { "color": "#5c6773ff" },

				"string.comment.info": {
					"color": "#4dbf99ff",
					"background_color": "#4dbf993d",
				},
				"string.comment.info.prefix": { "color": "#5c6773ff" },
				"string.comment.info.bracket": { "color": "#4dbf99ff" },
				"string.comment.info.user": { "color": "#4dbf99ff" },
				"string.comment.info.text": { "color": "#5c6773ff" },

				"keyword.comment.warn": {
					"color": "#f1ad49ff",
					"background_color": "#f1ad493d",
				},
				"keyword.comment.warn.prefix": { "color": "#5c6773ff" },
				"keyword.comment.warn.bracket": { "color": "#f1ad49ff" },
				"keyword.comment.warn.user": { "color": "#f1ad49ff" },
				"keyword.comment.warn.text": { "color": "#5c6773ff" },

				"property.comment.error": {
					"color": "#ef7271ff",
					"background_color": "#ef72713d",
				},
				"property.comment.error.prefix": { "color": "#5c6773ff" },
				"property.comment.error.bracket": { "color": "#ef7271ff" },
				"property.comment.error.user": { "color": "#ef7271ff" },
				"property.comment.error.text": { "color": "#5c6773ff" },
			},
		},
		"Tokyo Night": {
			"editor.gutter.background": "#171720",
			"syntax": {
				// TODO WIP MAYBE ?
				// INFO NOTE XXX DOCS PERF TEST *
				// WARN WARNING HACK SAFETY IMPORTANT #
				// ERROR FIXME FIX BUG DELETE !

				"constant.comment.todo": {
					"color": "#55b4D3",
					"background_color": "#55b4D340",
				},
				"constant.comment.todo.prefix": { "color": "#51597d" },
				"constant.comment.todo.bracket": { "color": "#55b4D3" },
				"constant.comment.todo.user": { "color": "#55b4D3" },
				"constant.comment.todo.text": { "color": "#51597d" },

				"string.comment.info": {
					"color": "#73DACA",
					"background_color": "#73DACA40",
				},
				"string.comment.info.prefix": { "color": "#51597d" },
				"string.comment.info.bracket": { "color": "#73DACA" },
				"string.comment.info.user": { "color": "#73DACA" },
				"string.comment.info.text": { "color": "#51597d" },

				"keyword.comment.warn": {
					"color": "#E0AF68",
					"background_color": "#E0AF6840",
				},
				"keyword.comment.warn.prefix": { "color": "#51597d" },
				"keyword.comment.warn.bracket": { "color": "#E0AF68" },
				"keyword.comment.warn.user": { "color": "#E0AF68" },
				"keyword.comment.warn.text": { "color": "#51597d" },

				"property.comment.error": {
					"color": "#F7768E",
					"background_color": "#F7768040",
				},
				"property.comment.error.prefix": { "color": "#51597d" },
				"property.comment.error.bracket": { "color": "#F7768E" },
				"property.comment.error.user": { "color": "#F7768E" },
				"property.comment.error.text": { "color": "#51597d" },
			},
		},
	},

	"show_whitespaces": "selection",

	"wrap_guides": [80, 100],
	"show_wrap_guides": true,

	"preferred_line_length": 80,

	"soft_wrap": "none",

	"which_key": {
		"enabled": true,
	},

	"active_pane_modifiers": {
		"border_size": 1.0,
		"inactive_opacity": 0.7,
	},
	"project_panel": {
		"dock": "left",
		"bold_folder_labels": true,
		"diagnostic_badges": false,
		"show_diagnostics": "all",
		"entry_spacing": "standard",
		"hide_root": true,
		"indent_size": 15,
	},
	"outline_panel": { "dock": "right" },

	"max_tabs": null, // unlimited tabzz
	"tab_bar": {
		"show": true, // Show/hide the tab bar
		"show_nav_history_buttons": true, // Show/hide history buttons on tab bar
		"show_tab_bar_buttons": false, // Show hide buttons (new, split, zoom)
	},
	"tabs": {
		"git_status": true, // Color to show git status
		"close_position": "left", // Close button position (left, right, hidden)
	},

	"indent_guides": {
		"coloring": "fixed",
		"line_width": 1,
		"active_line_width": 3,
	},

	/* Hiding stuff: */
	"git": {
		// "git_gutter": "hide",
		"hunk_style": "unstaged_hollow",
	},
	"gutter": {
		// "folds": false,
		"breakpoints": false,
		"bookmarks": false,
		"runnables": false,
		"min_line_number_digits": 0,
	},
	"scrollbar": { "git_diff": false },
	"toolbar": {
		// "breadcrumbs": false,
		"quick_actions": false,
	},
	"minimap": {
		"show": "never", // When to show (auto, always, never)
		"display_in": "all_editors", // Where to show (active_editor, all_editors)
		"thumb_border": "none", // Thumb border (left_open, right_open, full, none)
		"max_width_columns": 80, // Maximum width of minimap
	},
	"collaboration_panel": { "button": false },
	"title_bar": {
		"show_branch_status_icon": true,
		"show_sign_in": false,
	},
	"search": { "button": false },

	/* TABS */
	"hard_tabs": true,
	"tab_size": 4,

	/* BEHAVIOR */
	"edit_predictions": {
		"allow_data_collection": "no",
	},
	"session": {
		"restore_unsaved_buffers": true,
		"trust_all_worktrees": false,
	},
	"use_system_path_prompts": false,
	"when_closing_with_no_tabs": "close_window", // When there are no open tabs left, Ctrl-w causes the window to close
	"remove_trailing_whitespace_on_save": true,
	"ensure_final_newline_on_save": false,
	"format_on_save": "off",
	"cli_default_open_behavior": "existing_window",

	// "disable_ai": true,
	"agent": {
		// "enabled": false,
		"message_editor_min_lines": 4,
		"terminal_init_command": "claude",
		"play_sound_when_agent_done": "when_hidden",
		"dock": "right",
		"sidebar_side": "right",
		"thinking_display": "auto",
	},
	"agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"mode": "acceptEdits",
			},
			"type": "registry",
		},
	},

	"file_types": {
		// "Nunjucks": ["html"],
		// "JSONC": ["jsonc"],
	},
	"languages": {
		"JSON": {
			// "format_on_save": "on",
			"formatter": "prettier",
		},
		"JSON5": {
			"formatter": {
				"external": {
					"command": "prettier",
					"arguments": [
						"--use-tabs",
						// "--tab-width",
						// "4",
						"--object-wrap",
						"collapse",
						"--stdin-filepath",
						"{buffer_path}",
						"--parser",
						"json5",
					],
				},
			},
		},
		"YAML": {
			"hard_tabs": false,
			"tab_size": 2,
		},
		"Markdown": {
			"soft_wrap": "editor_width",
			"remove_trailing_whitespace_on_save": false,
		},
		"Python": {
			"hard_tabs": false,
			"tab_size": 4,
			"language_servers": [
				"ty",
				"ruff",
				"!basedpyright", // disable basedpyright
				// "...", // enable everything else
			],
		},
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
			},
		},
	},

	"lsp": {
		// "ty": {
		// 	"settings": {
		// 		// "diagnosticMode": "off",
		// 	},
		// },
	},
	/* MISC */
	"ssh_connections": [
		{
			"host": "rpi",
			"args": [],
			"projects": [
				{
					"paths": ["/home/abi/projects/realtime-voice-agent-vibes"],
				},
			],
		},
	],
}
